begin
    class Conway(height, width);
        integer height, width;
    begin
        integer start = 0;
        integer last = height * width - 1;
        integer array grid(start:last);

        procedure draw(state);
            integer state;
        begin
            if state = 1 then outchar('#') else outchar('.');
        end;

        procedure print;
        begin
            integer i;
            for i := start step 1 until last do
            begin
               if mod(i, width) = 0 then outimage;
               draw(grid(i));
            end;
        end;

        integer procedure floorMod(x, y);
            integer x, y;
        begin
            integer result;
            if x > 0 then result := mod(x, y);
            if x < 0 then result := mod(x + y, y);
            if x = 0 then result := 0;
            floorMod := result;
        end;

        procedure assign(x, y, state);
            integer x, y, state;
        begin
            integer h = floorMod(x, height);
            integer w = floorMod(y, width);
            integer i = h * width + w;
            grid(i) := state;
        end;

        integer procedure query(x, y);
            integer x, y;
        begin
            integer h = floorMod(x, height);
            integer w = floorMod(y, width);
            integer i = h * width + w;
            query := grid(i);
        end;

        integer procedure countNeighbors(x, y);
            integer x, y;
        begin
            integer n0  = query(x + 1, y    );
            integer ne0 = query(x + 1, y + 1);
            integer e0  = query(x,     y + 1);
            integer se0 = query(x - 1, y + 1);
            integer s0  = query(x - 1, y    );
            integer sw0 = query(x - 1, y - 1);
            integer w0  = query(x,     y - 1);
            integer nw0 = query(x + 1, y - 1);
            countNeighbors := n0 + ne0 + e0 + se0 + s0 + sw0 + w0 + nw0;
        end;

        integer procedure gameLogic(state, neighbors);
            integer state, neighbors;
        begin
            integer result;
            if state = 1 then
            begin
               if neighbors < 2 then result := 0 else
               if neighbors > 3 then result := 0 else
               result := state;
            end else
            if neighbors = 3 then result := 1 else
            result := state;
            gameLogic := result;
        end;

        integer procedure stepCell(x, y);
            integer x, y;
        begin
            integer state = query(x, y);
            integer neighbors = countNeighbors(x, y);
            integer nextState = gameLogic(state, neighbors);
            stepCell := nextState;
        end;

        procedure setGrid(newGrid);
            integer array newGrid;
        begin
            integer i;
            for i := start step 1 until last do
            begin
                grid(i) := newGrid(i);
            end;
        end;

        procedure simulate;
        begin
            integer array newGrid(start:last);
            integer i, j;
            for i := 0 step 1 until height - 1 do
            begin
                for j := 0 step 1 until width - 1 do
                begin
                    integer nextState = stepCell(i, j);
                    integer k = i * width + j;
                    newGrid(k) := nextState;
                end;
            end;
            setGrid(newGrid);
        end;

        procedure sleep(n);
            long real n;
        begin
            long real t0;
            t0 := clockTime;
            while clockTime - t0 <= n do
            begin
            end;
        end;

    end;

    ref (Conway) c;
    c :- new Conway(10, 20);

    c.assign(0, 3, 1);
    c.assign(1, 4, 1);
    c.assign(2, 2, 1);
    c.assign(2, 3, 1);
    c.assign(2, 4, 1);

    c.print;

    while true do
    begin
        c.simulate;
        c.print;
        c.sleep(0.001);
    end;

end

-- run with https://portablesimula.github.io/github.io/
